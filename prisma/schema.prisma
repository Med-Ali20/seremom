generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CheckInSlot {
  MORNING
  MIDDAY
  EVENING
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String?
  firstname            String?
  lastname             String?
  role                 Role                 @default(USER)
  googleId             String?              @unique
  provider             AuthProvider         @default(EMAIL)
  createdAt            DateTime             @default(now())
  checkIns             CheckIn[]
  journalEntries       JournalEntry[]
  journalReflections   JournalReflection[]
  assessmentResults    AssessmentResult[]
  chatConversations    ChatConversation[]
  completedOnboarding  Boolean              @default(false)
  questionnaireAnswers QuestionnaireAnswer?
}

model QuestionnaireAnswer {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthTiming      String[]
  healthConditions String[]
  supportNeeds     String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

model CheckIn {
  id        String      @id @default(uuid())
  date      DateTime
  slot      CheckInSlot @default(MORNING)
  stress    Int
  mood      Int
  energy    Int
  sleep     Int
  notes     String?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, date, slot])
  @@index([userId])
}

model Assessment {
  id           String              @id @default(uuid())
  title        String              @unique
  description  String?
  duration     Int
  isIndividual Boolean             @default(true)
  category     AssessmentCategory? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  questions    Json
  diagnoses    Json
  tags         String[]            @default([])
  validated    Boolean             @default(false)
  icon         String?
  createdAt    DateTime            @default(now())
}

model AssessmentCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  icon        String?
  createdAt   DateTime     @default(now())
  assessments Assessment[]
}

// ── AssessmentResult now stores ALL attempts, not just the latest ─────────────
model AssessmentResult {
  id              String   @id @default(uuid())
  assessmentId    String
  assessmentTitle String
  answers         Json
  totalScore      Int?
  topScore        Int?
  diagnosis       String?
  attempt         Int      @default(1)   // increments on each retake
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, assessmentId])
}

model JournalReflection {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  date      String   // YYYY-MM-DD — one per user per day
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  title     String?
  feeling   String
  thoughts  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Article {
  id          String           @id @default(uuid())
  title       String
  description String
  duration    String
  content     String
  image       String
  category    ArticleCategory? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  tags        String[]
  date        DateTime
  status      String           @default("published")
}

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}
